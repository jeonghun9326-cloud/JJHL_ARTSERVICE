{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "jjhl-studio",
  "pages_build_output_dir": "./public",
  "compatibility_date": "2026-07-29",
  "compatibility_flags": ["nodejs_compat"],

  // wrangler d1 create jjhl-studio-db 실행 후 발급되는 database_id로 교체하세요.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "jjhl-studio-db",
      "database_id": "e14f7ffc-b8fc-4363-81f3-66906ead87ee"
    }
  ]
}
